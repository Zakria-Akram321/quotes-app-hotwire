<p style="color: green"><%= notice %></p>

<div class="flex justify-between">
  <h1 class="text-4xl font-semibold">Quotes</h1>
  <%= link_to "Add quotes", 
              new_quote_path, 
              data: {turbo_frame: dom_id(Quote.new)},
              class:"bg-[#df5034] px-7 py-3 text-white font-semibold capitalize inline-block rounded-lg" %>
</div>
<hr class="my-4">

<%= turbo_stream_from "quotes" %>

<%= turbo_frame_tag Quote.new %>
<%= turbo_frame_tag "quotes" do %>
    <%= render @quotes %>
<%end%>
